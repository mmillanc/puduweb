# ============================================================
# PuduWeb - Variables de entorno
# ============================================================
# Copia este archivo a .env.local y completa con tus valores.
#
# En Vercel, configura estas variables para cada entorno:
#   - Production (main):    variables de SUPABASE_PROD
#   - Staging (staging):    variables de SUPABASE_STAGING
#   - Preview (feature/*):  variables de SUPABASE_STAGING
# ============================================================

# --- PRODUCCIÓN (rama main) ---
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# NEXT_PUBLIC_SITE_URL=https://puduweb.cl

# --- STAGING (rama staging) ---
# Usar un proyecto Supabase separado para pruebas
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-staging.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-staging-aqui
# NEXT_PUBLIC_SITE_URL=https://staging-puduweb.vercel.app
